# PostgreSQL connection string used by Prisma.
# Local dev (matches docker-compose.yml defaults):
DATABASE_URL="postgresql://nexus:nexus_dev_password@localhost:5432/nexus_website"

# Random long string used to sign the admin session cookie.
# Generate one with: openssl rand -hex 32
SESSION_SECRET="replace-with-a-long-random-string"

# Bcrypt hash of the admin dashboard password (never store the plain password).
# Generate one with: npm run hash-password -- "your-password-here"
# IMPORTANT: paste the script's output exactly as printed (with \$ instead of $).
# Next.js's env loader expands unescaped $name in .env values, which silently
# corrupts a raw bcrypt hash and makes admin login fail with no clear error.
ADMIN_PASSWORD_HASH="replace-with-bcrypt-hash"

# Used by docker-compose.yml to set the Postgres container's password.
POSTGRES_PASSWORD="nexus_dev_password"
